<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/bg.css">
    <title>
        PokéQuiz - PokéWeb
    </title>
</head>
<style>
    .dropdown-item:hover {
        background-color: #fccece;
    }

    .btn:hover {
        background-color: #7e3636;
    }
</style>

<body class="d-flex flex-column min-vh-100">
    <%- include('header') %>
    <%- include('pokeball-bg') %>

        <!-- Fills the space between navbar and footer, and centers its content both ways -->
        <main class="flex-grow-1 d-flex flex-column align-items-center justify-content-center">
            <!-- Real heading for screen readers / SEO; the curved version below is the visible one -->
            <h2 class="visually-hidden">Pokémon Quiz</h2>

            <svg viewBox="0 0 500 110" aria-hidden="true"
                style="width: min(100%, 520px); height: auto; display: block; margin: 0 auto 0.25rem;">
                <defs>
                    <!-- Arch: ends at y=90, peaks at about y=55 in the middle -->
                    <path id="titleCurve" d="M 20,90 Q 250,20 480,90" fill="none" />
                </defs>
                <text fill="currentColor" font-size="50" font-weight="500" style="font-family: inherit;">
                    <textPath href="#titleCurve" startOffset="50%" text-anchor="middle">Pokémon Quiz</textPath>
                </text>
            </svg>

            <p class="text-center mb-3" style="margin-top: -1.9rem;">Test your Pokémon Knowledge!</p>

            <div class="dropdown">
                <button class="btn btn-outline-dark dropdown-toggle px-4 py-2 shadow-sm" type="button"
                    id="formDropdownMenu" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px;">
                    <span id="currentFormLabel">Select Quiz Mode...</span>
                </button>
                <ul class="dropdown-menu shadow text-center" aria-labelledby="formDropdownMenu"
                    style="border-radius: 20px; min-width: 205px;">
                    <li><a class="dropdown-item py-2" href="/pokedexQuiz">Pokédex Quiz</a></li>
                    <li><a class="dropdown-item py-2" href="#">(Coming Soon!)</a></li>
                    <li><a class="dropdown-item py-2" href="#">(Coming Soon!)</a></li>
                </ul>
            </div>
        </main>

        <%- include('footer') %>
</body>