<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <title>Pokémons - PokéWeb</title>
</head>
<style>
    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgb(181, 105, 105);
        background-color: #f8f9fa;
    }

    /* Hide extra details by default with zero height and opacity */
    .card-details {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
    }

    /* Reveal and expand the details when the card is hovered */
    .card:hover .card-details {
        max-height: 150px;
        opacity: 1;
        margin-top: 10px;
    }

    .genBadge {
        background-color: #da5b5b;
    }

    /* Fix card header spacing for mobile screens */
    .pokemon-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-bottom: 0.5rem;
    }

    /* Ensure long names break safely or scale cleanly on mobile */
    .pokemon-card-title {
        font-size: 1.1rem;
        word-break: break-word;
    }

    @media (max-width: 576px) {
        .pokemon-card-title {
            font-size: 0.95rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.querySelector('input[name="search"]');
        const filterForm = document.querySelector('form');
        let searchTimeout;

        if (searchInput && filterForm) {
            if (sessionStorage.getItem('refocusSearch') === '1') {
                sessionStorage.removeItem('refocusSearch');
                searchInput.focus();
                const end = searchInput.value.length;
                searchInput.setSelectionRange(end, end);
            }

            searchInput.addEventListener('input', () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    sessionStorage.setItem('refocusSearch', '1');
                    filterForm.requestSubmit();
                }, 500);
            });
        }

        if (filterForm) {
            const filterPanel = document.querySelector('#filterCollapse');
            filterPanel?.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    clearTimeout(searchTimeout);
                    filterForm.requestSubmit();
                }
            });
        }
    });
</script>

<script>
    // Swipe left = next page, swipe right = previous page (touch screens only)
    (function () {
        const next = document.getElementById('nextPageLink');
        const prev = document.getElementById('prevPageLink');
        if (!next || !prev) return;               // only one page of results

        let startX = 0, startY = 0, tracking = false;

        document.addEventListener('touchstart', e => {
            if (e.touches.length !== 1) return;
            const t = e.touches[0];
            // Ignore taps on inputs / the open filter panel, and swipes that begin at the very screen edge
            // (those are the browser's own back/forward gesture)
            const blocked = e.target.closest('input, textarea, select, button, #filterCollapse.show');
            const edge = t.clientX < 30 || t.clientX > window.innerWidth - 30;
            tracking = !blocked && !edge;
            startX = t.clientX;
            startY = t.clientY;
        }, { passive: true });

        document.addEventListener('touchend', e => {
            if (!tracking) return;
            tracking = false;
            const t = e.changedTouches[0];
            const dx = t.clientX - startX;
            const dy = t.clientY - startY;

            // Must be a clear, mostly-horizontal swipe so normal scrolling never triggers it
            if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 1.8) return;

            window.location.href = (dx < 0 ? next : prev).href;
        }, { passive: true });
    })();
</script>

<body>
    <%- include('header') %>
        <% 
            const buildQuery = (overrides = {}) => {
                const params = new URLSearchParams();
                const merged = { ...(typeof queryParams !== 'undefined' ? queryParams : {}), ...overrides };
                Object.entries(merged).forEach(([key, value]) => {
                    if (value === undefined || value === null || value === '') return;
                    (Array.isArray(value) ? value : [value]).forEach(v => params.append(key, v));
                });
                return params.toString();
            };
        %>

            <div class="container mt-5">
                <h1 class="mb-5 text-center">Pokédex</h1>
                
                <!-- Centered Search and Filter Bar -->
                <div class="row justify-content-center mb-4">
                    <div class="col-md-8 position-relative">
                        <form action="/pokedex" method="GET">

                            <!-- Top Search Bar & Filter Toggle Row -->
                            <div class="d-flex justify-content-center align-items-center">
                                <input type="text" name="search" class="form-control shadow-sm"
                                    placeholder="Search Pokémon..."
                                    value="<%= typeof searchPokemon !== 'undefined' ? searchPokemon : '' %>">

                                <button class="btn btn-outline-primary ms-2 shadow-sm" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false"
                                    aria-controls="filterCollapse">
                                    <i class="bi bi-filter"></i>
                                </button>

                                <a href="/pokedex?<%= buildQuery({ sort: currentSortQuery === 'asc' ? 'desc' : 'asc', page: undefined }) %>"
                                    class="ms-3 text-muted text-decoration-none" style="font-size: 1.3rem;">
                                    ⇅
                                </a>

                                <a href="/pokedex" class="ms-3 text-muted text-decoration-none" title="Clear Filters"
                                    style="font-size: 1.3rem;">
                                    ⟳
                                </a>
                            </div>

                            <!-- Collapsible Filter Panel -->
                            <div class="collapse mt-2 position-absolute start-0 end-0 shadow-lg" id="filterCollapse"
                                style="z-index: 1000;">
                                <div class="card card-body bg-white border">
                                    <div class="row">
                                        <!-- LEFT: Generations (top) + Alphabetical (bottom) -->
                                        <div class="col-md-6 mb-2 border-end">
                                            <h6 class="fw-bold text-secondary">Generations</h6>
                                            <div class="row g-1">
                                                <% const regions = ['', 'Kanto', 'Johto', 'Hoenn', 'Sinnoh', 'Unova', 'Kalos', 'Alola', 'Galar', 'Paldea']; %>
                                                <% for (let i = 1; i <= 9; i++) { %>
                                                    <div class="col-4">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="generations" value="<%= i %>"
                                                                id="gen<%= i %>"
                                                                <%= typeof selectedGens !== 'undefined' && selectedGens.includes(String(i)) ? 'checked' : '' %>>
                                                            <label class="form-check-label small" for="gen<%= i %>">
                                                                Gen <%= i %> (<%= regions[i] %>)
                                                            </label>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <hr class="my-3">

                                            <h6 class="fw-bold text-secondary">Alphabetical</h6>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="sortby" value="name" id="sortByName"
                                                    <%= typeof currentSortBy !== 'undefined' && currentSortBy === 'name' ? 'checked' : '' %>>
                                                <label class="form-check-label small" for="sortByName">Alphabetical (A–Z)</label>
                                            </div>
                                        </div>

                                        <!-- RIGHT: Types -->
                                        <div class="col-md-6 mb-2">
                                            <h6 class="fw-bold text-secondary">Types</h6>
                                            <div style="max-height: 340px; overflow-y: auto;" class="pe-2">
                                                <% const allTypes = ['grass', 'poison', 'fire', 'water', 'bug', 'normal', 'electric', 'fairy', 'fighting', 'psychic', 'rock', 'ghost', 'ice', 'dragon', 'ground', 'steel', 'dark', 'flying']; %>
                                                <div class="row g-1">
                                                    <% allTypes.forEach(t => { %>
                                                        <div class="col-6">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="types" value="<%= t %>"
                                                                    id="type_<%= t %>"
                                                                    <%= typeof selectedTypes !== 'undefined' && selectedTypes.includes(t) ? 'checked' : '' %>>
                                                                <label class="form-check-label text-capitalize small" for="type_<%= t %>">
                                                                    <%= t %>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="small text-muted mb-0 mt-2">Enter to apply.</p>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Pokémon Grid Layout -->
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-3 g-3">
                        <% if (pokemons.length === 0) { %>
                            <div class="container mt-5">
                                <p class="text-muted text-center">Invalid</p>
                            </div>
                        <% } else { %>
                            <% pokemons.forEach(pokemon => { %>
                                <div class="col">
                                    <div class="card h-100 p-2 p-md-3 shadow-sm text-center" style="cursor: pointer;"
                                        onclick="window.location.href='/pokemon/<%= pokemon.id %>'">

                                        <!-- Top Row: ID on the left, Generation badge on the right (Fixed mobile crowding) -->
                                        <div class="pokemon-card-header">
                                            <span class="text-muted fw-bold">#<%= String(pokemon.id).padStart(3, '0') %></span>
                                            <span class="genBadge badge opacity-75 small">Gen <%= pokemon.generation %></span>
                                        </div>

                                        <% if (pokemon.image) { %>
                                            <img src="<%= pokemon.image %>"
                                                alt="<%= pokemon.name.replace(/-(male|female)$/i, '') %>"
                                                class="img-fluid mx-auto mb-2" style="max-height: 120px;">
                                        <% } else { %>
                                            <p class="text-muted">No image available</p>
                                        <% } %>

                                        <!-- Pokémon Name (Fixed awkward wrapping with word-break) -->
                                        <h5 class="mb-1 mt-2 pokemon-card-title text-capitalize fw-bold">
                                            <%= pokemon.name.replace(/-(male|female)$/i, '') %>
                                        </h5>

                                        <% 
                                            const typeColors = { 
                                                grass: '#9bcc50', poison: '#b97fc9', fire: '#fd7d24', 
                                                water: '#4592c4', bug: '#729f3f', normal: '#a4acaf', 
                                                electric: '#eed535', fairy: '#fdb9e9', fighting: '#d56723', 
                                                psychic: '#f366b9', rock: '#a38c21', ghost: '#7b62a3', 
                                                ice: '#51c4e7', dragon: '#53a4cf', ground: '#ab9842', 
                                                steel: '#9eb7b8', dark: '#707070', flying: '#3dc7be' 
                                            }; 
                                        %>

                                        <p class="mb-2 text-muted">
                                            <% if (pokemon.type) { %>
                                                <% const typesArray = pokemon.type.split(',').map(t => t.trim().toLowerCase()); %>
                                                <% typesArray.forEach(t => { %>
                                                    <span class="badge me-1 text-white"
                                                        style="background-color: <%= typeColors[t] || '#6c757d' %>;">
                                                        <%= t %>
                                                    </span>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="text-muted">None</span>
                                            <% } %>
                                        </p>

                                        <div class="card-details">
                                            <p class="small text-secondary mb-1">
                                                <%= pokemon.description %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                        <%
                        // Builds a /pokedex URL that keeps every current filter (including multi-select ones) and sets the page
                        const pageUrl = p => {
                            const sp = new URLSearchParams();
                            Object.entries(queryParams || {}).forEach(([k, v]) => {
                                if (k === 'page') return;
                                (Array.isArray(v) ? v : [v]).forEach(x => sp.append(k, x));
                            });
                            sp.set('page', p);
                            return '/pokedex?' + sp.toString();
                        };
                        const prevPage = currentPage <= 1 ? totalPages : currentPage - 1;
                        const nextPage = currentPage >= totalPages ? 1 : currentPage + 1;
                        %>
                        <nav aria-label="Pokedex Navigation" class="d-flex justify-content-center mt-5 mb-4">
                            <ul class="pagination justify-content-center mb-0">

                                <li class="page-item">
                                    <a class="page-link" id="prevPageLink" href="<%= pageUrl(prevPage) %>">&lt;</a>
                                </li>

                                <li class="page-item disabled">
                                    <span class="page-link bg-light text-dark">Page <%= currentPage %> of <%= totalPages %></span>
                                </li>

                                <li class="page-item">
                                    <a class="page-link" id="nextPageLink" href="<%= pageUrl(nextPage) %>">&gt;</a>
                                </li>

                            </ul>
                        </nav>
                    <% } %>

                    <footer class="small text-center text-muted mt-4">
                        <p>Pokémon data sourced from <a href="https://pokeapi.co/" target="_blank">PokéAPI</a>.<br>All rights belong to Nintendo.</p>
                    </footer>
                </div>
            </div>
</body>
</html>