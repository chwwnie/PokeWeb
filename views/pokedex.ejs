<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Pokemons</title>
</head>
<style>
    .card {
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgb(181, 105, 105);
        background-color: #f8f9fa;
    }

    /* Hide extra details by default with zero height and opacity */
    .card-details {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
    }

    /* Reveal and expand the details when the card is hovered */
    .card:hover .card-details {
        max-height: 150px;
        /* Adjust depending on how much text you have */
        opacity: 1;
        margin-top: 10px;
    }
</style>

<body>
    <%- include('header') %>
        <div class="container mt-5">
            <h1 class="mb-4 text-center">Pokedex</h1>

            <!-- 
      row-cols-md-3: Shows 3 cards per row on medium screens
      row-cols-lg-4: Shows 4 cards per row on large screens
      g-4: Adds consistent spacing (gaps) between cards
    -->
            <div class="row row-cols-3 row-cols-md-3 row-cols-lg-3 g-3">
                <% if (pokemons.length===0) { %>
                    <div class="col">
                        <p class="text-muted">No pokemons added yet!</p>
                    </div>
                    <% } else { %>
                        <% pokemons.forEach(pokemon=> { %>
                            <div class="col">
                                <!-- card h-100 ensures all cards in a row match the same height -->
                                <div class="card h-100 p-3 shadow-sm text-center" style="cursor: pointer;"
                                    onclick="window.location.href='/pokemon/<%= pokemon.id %>'">

                                    <p class="mb-1 text-muted">
                                        <small>#<%= String(pokemon.id).padStart(3, '0' ) %></small>
                                    </p>

                                    <% if (pokemon.image) { %>
                                        <img src="<%= pokemon.image %>" alt="<%= pokemon.name %>"
                                            class="img-fluid mx-auto mb-2" style="max-height: 120px;">
                                        <% } else { %>
                                            <p class="text-muted">No image available</p>
                                            <% } %>

                                                <h5 class="mb-1 mt-2 card-title text-capitalize">
                                                    <%= pokemon.name %>
                                                </h5>

                                                <% // Map standard Pokémon types to their colors const typeColors={
                                                    const typeColors={ grass: '#9bcc50' , poison: '#b97fc9' ,
                                                    fire: '#fd7d24' , water: '#4592c4' , bug: '#729f3f' ,
                                                    normal: '#a4acaf' , electric: '#eed535' , fairy: '#fdb9e9' ,
                                                    fighting: '#d56723' , psychic: '#f366b9' , rock: '#a38c21' ,
                                                    ghost: '#7b62a3' , ice: '#51c4e7' , dragon: '#53a4cf' ,
                                                    ground: '#ab9842' , steel: '#9eb7b8' , dark: '#707070' ,
                                                    flying: '#3dc7be' }; %>

                                                    <p class="mb-2 text-muted">
                                                        <% if (pokemon.type) { %>
                                                            <% const typesArray=pokemon.type.split(',').map(t=>
                                                                t.trim().toLowerCase()); %>
                                                                <% typesArray.forEach(t=> { %>
                                                                    <!-- Directly evaluate the color inside the style output tag -->
                                                                    <span class="badge me-1 text-white"
                                                                        style="background-color: <%= typeColors[t] || '#6c757d' %>;">
                                                                        <%= t %>
                                                                    </span>
                                                                    <% }) %>
                                                                        <% } else { %>
                                                                            <span class="text-muted">None</span>
                                                                            <% } %>
                                                    </p>

                                                    <div class="card-details">
                                                        <p class="small text-secondary mb-1"> <%= pokemon.description %></p>
                                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
            </div>
            <footer class="small text-center text-muted mt-4">
                <p>Pokémon data sourced from <a href="https://pokeapi.co/" target="_blank">PokeAPI</a>. <br>All rights
                    belong to Nintendo.</p>
            </footer>
        </div>
        </div>
</body>