<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>
        <%= pokemon.pokemon_name %> - PokemonWeb
    </title>
</head>
<style>
    .badge {
        font-size: 1rem;
        padding: 0.5em 0.75em;
    }

    .progress-bar {
        transition: width 0.5s ease-in-out;
        background-color: #528ad4;
    }

    .shiny-button {
        transition: transform 0.2s ease-in-out;
        justify-content: center;
        align-items: center;
    }

    .shiny-button:hover {
        transform: scale(1.3);
        /* Scales the button up by 20% on hover */
    }

    .evo:hover {
        transform: scale(1.1);
        transition: transform 0.2s ease-in-out;

    }
</style>

<body>
    <%- include('header') %>

        <div class="container mt-5">

            <h3 class="text-muted text-center">
                <small>#<%= String(pokemon.pokemon_id).padStart(3, '0' ) %></small>
            </h3>

            <div class="text-center mb-4">
                <h1 class="text-capitalize mb-1">
                    <%= pokemon.pokemon_name %>
                </h1>

                <% if (pokemon.pokemon_shiny_img) { %>
                    <button id="shinyToggleBtn" class="shiny-button btn d-inline-block" onclick="toggleShiny()"
                        title="View Shiny" style="cursor: pointer; font-size: 1.2rem;">
                        ✨
                    </button>
                    <% } %>
            </div>

            <div class="d-flex flex-row align-items-center justify-content-center gap-3 my-3">
                <div class="col-1 text-end">

                    <a href="/pokemon/<%= pokemon.prev_id %>"
                        class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                        style="width: 45px; height: 45px;" title="Previous Pokémon">
                        <i class="bi bi-chevron-left fs-5"></i>
                    </a>

                </div>
                <div class="col-md-6 text-center">
                    <% if (pokemon.pokemon_img) { %>
                        <!-- Added id="pokemonImage" back here so JS can target it -->
                        <img id="pokemonImage" src="<%= pokemon.pokemon_img %>" alt="<%= pokemon.pokemon_name %>"
                            class="img-fluid mb-2" style="max-height: 300px;">
                        <% } else { %>
                            <p class="text-muted">No image available</p>
                            <% } %>

                                <!-- Audio Player Section -->
                                <div class="text-center mt-2 mb-3">
                                    <% if (pokemon.pokemon_cry_latest) { %>
                                        <button class="btn btn-outline-primary btn-sm me-2"
                                            onclick="playCry('<%= pokemon.pokemon_cry_latest %>')">
                                            <i class="bi bi-soundwave"></i> Latest Cry
                                        </button>
                                        <% } %>

                                            <% if (pokemon.pokemon_cry_legacy) { %>
                                                <button class="btn btn-outline-primary btn-sm"
                                                    onclick="playCry('<%= pokemon.pokemon_cry_legacy %>')">
                                                    <i class="bi bi-soundwave"></i> Classic Cry
                                                </button>
                                                <% } %>
                                </div>

                                <% const typeColors={ grass: '#9bcc50' , poison: '#b97fc9' , fire: '#fd7d24' ,
                                    water: '#4592c4' , bug: '#729f3f' , normal: '#a4acaf' , electric: '#eed535' ,
                                    fairy: '#fdb9e9' , fighting: '#d56723' , psychic: '#f366b9' , rock: '#a38c21' ,
                                    ghost: '#7b62a3' , ice: '#51c4e7' , dragon: '#53a4cf' , ground: '#ab9842' ,
                                    steel: '#9eb7b8' , dark: '#707070' , flying: '#3dc7be' }; %>

                                    <p class="mb-2 text-center">
                                        <% if (pokemon.type) { %>
                                            <% const typesArray=pokemon.type.split(',').map(t=>
                                                t.trim().toLowerCase());
                                                %>
                                                <% typesArray.forEach(t=> { %>
                                                    <span class="badge me-1 text-white"
                                                        style="background-color: <%= typeColors[t] || '#6c757d' %>;">
                                                        <%= t %>
                                                    </span>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <span class="text-muted">None</span>
                                                            <% } %>
                                    </p>

                </div>
                <!-- Right Arrow (Next Pokémon) -->
                <div class="col-1 text-start">
                    <% if (pokemon.next_id) { %>
                        <a href="/pokemon/<%= pokemon.next_id %>"
                            class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                            style="width: 45px; height: 45px;" title="Next Pokémon">
                            <i class="bi bi-chevron-right fs-5"></i>
                        </a>
                        <% } %>
                </div>
            </div>

            <div class="row mt-4 text-center">
                <div class="col">
                    <i>
                        "<%= pokemon.pokemon_desc %>"
                    </i>
                </div>
            </div>
            <br>

            <div class="row justify-content-center mt-2 stats-container">
                <div class="col-md-8">
                    <div class="card p-5 shadow-sm">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <p class="mb-0 text-muted small">Height</p>
                                <p class="mb-0 fw-bold" style="font-size: 1.2rem;">
                                    <%= pokemon.pokemon_height %> m
                                        <span class="text-muted fw-normal">(<%= (pokemon.pokemon_height *
                                                3.28084).toFixed(1) %> ft)</span>
                                </p>
                            </div>
                            <div class="col-6">
                                <p class="mb-0 text-muted small">Weight</p>
                                <p class="mb-0 fw-bold" style="font-size: 1.2rem;">
                                    <%= pokemon.pokemon_weight %> kg
                                        <span class="text-muted fw-normal">(<%= (pokemon.pokemon_weight *
                                                2.20462).toFixed(1) %> lbs)</span>
                                </p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 mt-3 text-center">
                                <p class="mb-1 text-muted small">Abilities</p>
                                <div>
                                    <% if (pokemon.pokemon_abilities) { %>
                                        <% let abilitiesArray=pokemon.pokemon_abilities.split(',');
                                            abilitiesArray.sort((a, b)=> {
                                            if (a.includes('(Hidden)')) return 1;
                                            if (b.includes('(Hidden)')) return -1;
                                            return 0;
                                            });
                                            %>
                                            <% abilitiesArray.forEach(ability=> { %>
                                                <span
                                                    class="badge bg-light text-dark mb-1 px-2 py-2 text-capitalize d-block mx-auto border"
                                                    style="max-width: 180px; font-size: 0.9rem;">
                                                    <%= ability.trim() %>
                                                </span>
                                                <% }) %>
                                                    <% } else { %>
                                                        <span class="text-muted">None</span>
                                                        <% } %>
                                </div>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-2">Base Stats</h5>

                        <!-- HP Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">HP</span>
                                <!-- Added class="counter" and data-target attribute -->
                                <span><%= pokemon.pokemon_hp %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <!-- Fixed pokemon.hp to pokemon.pokemon_hp -->
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_hp / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Attack Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Attack</span>
                                <!-- Added class="counter" and data-target attribute -->
                                <span><%= pokemon.pokemon_atk %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <!-- Fixed pokemon.atk to pokemon.pokemon_atk -->
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_atk / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Defense Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Defense</span>
                                <span><%= pokemon.pokemon_def %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_def / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Sp. Attack Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Sp. Attack</span>
                                <span><%= pokemon.pokemon_sp_atk %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_sp_atk / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Sp. Defense Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Sp. Defense</span>
                                <span><%= pokemon.pokemon_sp_def %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_sp_def / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Speed Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Speed</span>
                                <span><%= pokemon.pokemon_speed %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_speed / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Speed Stat -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">Speed</span>
                                <span><%= pokemon.pokemon_speed %></span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar" role="progressbar"
                                    style="width: 0%; transition: width 1s cubic-bezier(0.1, 1, 0.1, 1);"
                                    data-target-width="<%= (pokemon.pokemon_speed / 255) * 100 %>%">
                                </div>
                            </div>
                        </div>

                        <!-- Evolution Section -->
                        <!-- Evolution Line Section -->
                        <hr class="my-4">
                        <div class="text-center mt-2">
                            <p class="mb-4 fw-semibold" style="font-size: 1.4rem;">Evolution Line</p>


                            <div class="d-flex align-items-center justify-content-center gap-3 flex-wrap">

                                <!-- 1. Pre-Evolution (If exists) -->
                                <% if (pokemon.evolved_from_name) { %>
                                    <a href="/pokemon/<%= pokemon.evolved_from_id %>" class="text-decoration-none">
                                        <div class=" evo d-flex flex-column align-items-center">
                                            <div class="rounded-circle bg-light border shadow-sm overflow-hidden d-flex align-items-center justify-content-center mb-1"
                                                style="width: 85px; height: 85px;">
                                                <% if (pokemon.evolved_from_img) { %>
                                                    <img src="<%= pokemon.evolved_from_img %>"
                                                        alt="<%= pokemon.evolved_from_name %>"
                                                        style="width: 65px; height: 65px; object-fit: contain;">
                                                    <% } %>
                                            </div>
                                            <span class="badge bg-secondary text-capitalize px-2 py-1"
                                                style="font-size: 0.75rem;">
                                                <%= pokemon.evolved_from_name %>
                                            </span>
                                        </div>
                                    </a>
                                    <span class="text-muted fw-bold">→</span>
                                    <% } %>

                                        <!-- 2. Current Pokémon (Highlighted) -->
                                        <div class="d-flex flex-column align-items-center">
                                            <div class="rounded-circle bg-white border border-primary border-3 shadow overflow-hidden d-flex align-items-center justify-content-center mb-1"
                                                style="width: 95px; height: 95px;">
                                                <% if (pokemon.pokemon_img) { %>
                                                    <img src="<%= pokemon.pokemon_img %>"
                                                        alt="<%= pokemon.pokemon_name %>"
                                                        style="width: 75px; height: 75px; object-fit: contain;">
                                                    <% } %>
                                            </div>
                                            <span class="badge bg-primary text-capitalize px-2 py-1"
                                                style="font-size: 0.8rem;">
                                                <%= pokemon.pokemon_name %>
                                            </span>
                                        </div>

                                        <!-- 3. Next Evolutions (Loops through all branching paths if any exist) -->
                                        <% if (pokemon.evolves_to_names) { %>
                                            <span class="text-muted fw-bold">→</span>
                                            <div class="d-flex flex-row gap-3 flex-wrap justify-content-center">
                                                <% const nextIds=pokemon.evolves_to_ids.split(','); const
                                                    nextNames=pokemon.evolves_to_names.split(','); const
                                                    nextImgs=pokemon.evolves_to_imgs.split(','); for (let i=0; i <
                                                    nextNames.length; i++) { %>
                                                    <a href="/pokemon/<%= nextIds[i] %>" class="text-decoration-none">
                                                        <div class="evo d-flex flex-column align-items-center">
                                                            <div class="rounded-circle bg-light border shadow-sm overflow-hidden d-flex align-items-center justify-content-center mb-1"
                                                                style="width: 85px; height: 85px;">
                                                                <% if (nextImgs[i]) { %>
                                                                    <img src="<%= nextImgs[i] %>"
                                                                        alt="<%= nextNames[i] %>"
                                                                        style="width: 65px; height: 65px; object-fit: contain;">
                                                                    <% } %>
                                                            </div>
                                                            <span class="badge bg-secondary text-capitalize px-2 py-1"
                                                                style="font-size: 0.75rem;">
                                                                <%= nextNames[i] %>
                                                            </span>
                                                        </div>
                                                    </a>
                                                    <% } %>
                                            </div>
                                            <% } %>

                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <a href="/pokedex" class="btn btn-outline-secondary" style="font-size: 1.2rem;">Back to
                            Pokedéx</a>
                    </div>

                    <footer class="small text-center text-muted mt-4 mb-5">
                        <p>Pokémon data sourced from <a href="https://pokeapi.co/" target="_blank">PokéAPI</a>.<br>All
                            rights belong to Nintendo.</p>
                    </footer>
                </div>
            </div>

            <!-- Client-side JavaScript functionality -->
            <script>
                // Audio playback handler
                function playCry(url) {
                    const audio = new Audio(url);
                    audio.play().catch(err => console.log("Audio playback blocked or failed:", err));
                }

                // Shiny image toggle handler
                let isShiny = false;
                const normalImg = "<%= pokemon.pokemon_img %>";
                const shinyImg = "<%= pokemon.pokemon_shiny_img %>";

                function toggleShiny() {
                    const imgElement = document.getElementById('pokemonImage');
                    const btnElement = document.getElementById('shinyToggleBtn');

                    isShiny = !isShiny;
                    if (isShiny) {
                        imgElement.src = shinyImg;
                        btnElement.classList.replace('btn-outline-warning', 'btn-warning');
                    } else {
                        imgElement.src = normalImg;
                        btnElement.classList.replace('btn-warning', 'btn-outline-warning');
                    }
                }
            </script>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const statsSection = document.querySelector('.stats-container');

                    if (!statsSection) return;

                    // Configure the observer
                    const observerOptions = {
                        root: null, // Uses the browser viewport
                        threshold: 0.4 // Triggers when 40% of the stats section becomes visible
                    };

                    const observer = new IntersectionObserver((entries, observerInstance) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                // 1. Animate Progress Bars
                                document.querySelectorAll('.progress-bar').forEach(bar => {
                                    bar.style.width = bar.getAttribute('data-target-width');
                                });

                                // 2. Animate Stat Number Count-Up
                                document.querySelectorAll('.counter').forEach(counter => {
                                    const target = +counter.getAttribute('data-target');
                                    const duration = 1000; // 1 second
                                    const startTime = performance.now();

                                    function updateCount(currentTime) {
                                        const elapsed = currentTime - startTime;
                                        const progress = Math.min(elapsed / duration, 1);
                                        const easeProgress = 1 - Math.pow(1 - progress, 3);

                                        counter.textContent = Math.floor(easeProgress * target);

                                        if (progress < 1) {
                                            requestAnimationFrame(updateCount);
                                        } else {
                                            counter.textContent = target;
                                        }
                                    }

                                    requestAnimationFrame(updateCount);
                                });

                                // Stop observing once the animation has been triggered
                                observerInstance.unobserve(entry.target);
                            }
                        });
                    }, observerOptions);

                    // Start observing the stats container
                    observer.observe(statsSection);
                });
            </script>
</body>

</html>